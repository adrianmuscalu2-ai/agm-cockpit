    },
    {
      "id": "agm-browser-public",
      "name": "AGM Browser public",
      "env": "AGM_BROWSER_PUBLIC_URL",
      "defaultUrl": "https://app.agmcockpit.com/",
      "capture": true
    },
    {
      "id": "turn-public",
      "name": "Turn Command Center public",
      "env": "AGM_TURN_PUBLIC_URL",
      "defaultUrl": "https://app.agmcockpit.com/turn",
      "capture": true
    },
    {
      "id": "agm-api-ready-public",
      "name": "API AGM ready public",
      "env": "AGM_API_READY_PUBLIC_URL",
      "defaultUrl": "https://api.agmcockpit.com/api/v1/health/ready",
      "capture": false
    },
    {
      "id": "agm-website-public",
      "name": "AGM Website public",
      "env": "AGM_WEBSITE_PUBLIC_URL",
      "defaultUrl": "https://agm-cockpit.pages.dev/",
      "capture": true
    }
  ],
  "operationsServices": [
    {
      "id": "server-primary",
      "label": "Server Principal",
      "kind": "http",
      "url": "https://api.agmcockpit.com/api/v1/health/live",
      "evaluator": "live",
      "healthyStatus": "ONLINE",
      "source": "API public · health/live"
    },
    {
      "id": "server-backup",
      "label": "Server Backup",
      "kind": "static",
      "staticStatus": "NOT APPLICABLE",
      "displayStatus": "NOT APPLICABLE · SINGLE-WRITER",
      "source": "Topologie Production validată · Hetzner single-writer, standby fără trafic Production"
    },
    {
      "id": "api",
      "label": "API",
      "kind": "http",
      "url": "https://api.agmcockpit.com/api/v1/health/ready",
      "evaluator": "ready",
      "healthyStatus": "READY",
      "source": "API public · health/ready"
    },
    {
      "id": "browser",
      "label": "Browser",
      "kind": "http",
      "url": "self",
      "evaluator": "http",
      "healthyStatus": "ONLINE",
      "source": "Origin AGM curent · aceeași rută ca UI LIVE"
    },
    {
      "id": "android",
      "label": "Android",
      "kind": "http",
      "url": "/__agm/telemetry/android",
      "evaluator": "ready",
      "healthyStatus": "READY",
      "source": "Collector Android local autorizat · ADB heartbeat fără identificatori de dispozitiv"
    },
    {
      "id": "ai",
      "label": "AI",
      "kind": "http",
      "url": "https://api.agmcockpit.com/api/v1/health/ready",
      "evaluator": "dependency",
      "dependency": "translationProvider",
      "healthyStatus": "READY",
      "source": "API ready · dependencies.translationProvider"
    },
    {
      "id": "databases",
      "label": "Baze de date",
      "kind": "http",
      "url": "https://api.agmcockpit.com/api/v1/health/ready",
      "evaluator": "dependency",
      "dependency": "database",
      "healthyStatus": "READY",
      "source": "API ready · dependencies.database"
    },
    {
      "id": "cloudflare-public",
      "label": "Cloudflare / rute publice",
      "kind": "http",
      "url": "https://app.agmcockpit.com/",
      "evaluator": "http",
      "healthyStatus": "ONLINE",
      "source": "Rută publică Cloudflare · app.agmcockpit.com",
      "showInOperations": false
    },
    {
      "id": "ui-live",
      "label": "UI LIVE",
      "kind": "static",
      "staticStatus": "READY",
      "displayStatus": "UI LIVE PASS",
      "source": "Runner UI LIVE · ultimul audit integral PASS",
      "showInOperations": false
    },
    {
      "id": "telemetry",
      "label": "Telemetrie",
      "kind": "aggregate",
      "healthyStatus": "READY",
      "source": "Collector central Turn · snapshoturi health persistate și reconciliate",
      "dependencies": ["server-primary", "api", "browser", "android", "ai", "databases", "cloudflare-public", "security"],
      "showInOperations": false
    },
    {
      "id": "security",
      "label": "Secret & Credentials Guardian",
      "kind": "http",
      "url": "https://api.agmcockpit.com/api/v1/security/secrets/health",
      "evaluator": "http",
      "healthyStatus": "READY",
      "source": "Secret Guardian telemetry v1 · metadate sigure",
      "showInOperations": true
    }
  ]
