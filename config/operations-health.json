      "defaultUrl": "http://127.0.0.1:5173/",
      "capture": true
    },
    {
      "id": "turn-local",
      "name": "Turn Command Center local",
      "env": "AGM_TURN_LOCAL_URL",
      "defaultUrl": "http://127.0.0.1:5173/turn",
      "capture": true
    },
    {
      "id": "agm-website-local",
      "name": "AGM Website local",
      "env": "AGM_WEBSITE_LOCAL_URL",
      "defaultUrl": "http://127.0.0.1:4321/",
      "capture": true
    },
    {
      "id": "agm-api-ready-local",
      "name": "API AGM ready local",
      "env": "AGM_API_READY_LOCAL_URL",
      "defaultUrl": "http://127.0.0.1:3000/api/v1/health/ready",
