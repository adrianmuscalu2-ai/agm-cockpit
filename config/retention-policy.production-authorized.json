{
  "schemaVersion": 1,
  "policyVersion": "owner-approved-production-activation-2026-08-16",
  "timezone": "UTC",
  "productionActivationAuthorized": true,
  "categories": {
    "expiredAuthSessions": { "enabled": true, "latencyHours": 24, "batchLimit": 10 },
    "revokedAuthSessions": { "enabled": true, "retentionDays": 30, "batchLimit": 10 },
    "completedDsarRecords": { "enabled": true, "calendarYearsAfterCompletion": 3, "provisionalLegalValidation": true, "batchLimit": 10 },
    "generatedDsarExports": { "enabled": true, "retentionDays": 7, "trigger": "EARLIER_OF_CONFIRMED_DELIVERY_OR_FIRST_TOKEN_EXPIRY", "batchLimit": 5 },
    "postgresBackups": { "enabled": true, "maxSuccessfulDailyGenerations": 7, "batchLimit": 2 },
    "suppressionLedgerEntries": { "enabled": true, "backupHorizonDays": 7, "verificationMarginDays": 30, "batchLimit": 5 },
    "identifierAuditLogs": { "enabled": true, "retentionDays": 90, "legalHoldException": true, "batchLimit": 10 }
  },
  "excluded": ["accounting", "invoices", "legally-required-commercial-documents"]
}
