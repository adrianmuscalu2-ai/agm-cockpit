NODE_ENV=development
PORT=3000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://localhost,https://agm-cockpit.pages.dev,https://app.agmcockpit.com
API_HOST=0.0.0.0
TRUST_PROXY_HOPS=0
# Public frontend origins: https://agm-cockpit.pages.dev,https://app.agmcockpit.com
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://localhost

DATABASE_URL=postgresql://agm:agm@localhost:5432/agm?schema=public
PRISMA_CONNECT_ON_BOOT=true

JWT_SECRET=generate-a-random-secret-with-at-least-32-characters
JWT_EXPIRES_IN=1h

DEFAULT_COMPANY_NAME=AGM
DEFAULT_COMPANY_COUNTRY=DE
DEFAULT_CURRENCY=EUR

SEED_OWNER_EMAIL=owner@agm.local
SEED_OWNER_PASSWORD=ChangeMe123!
SEED_OWNER_NAME=AGM Owner

# Canonical Product Owner destination for source freshness/expiry alerts.
# Deliberately blank until explicitly configured; SEED_OWNER_EMAIL is not used as an implicit fallback.
AGM_PRODUCT_OWNER_ALERT_EMAIL=
AGM_SOURCE_FRESHNESS_SCHEDULER_ENABLED=false
AGM_SOURCE_FRESHNESS_SCAN_INTERVAL_MS=86400000
AGM_SOURCE_FRESHNESS_REMINDER_DAYS=

# Android release signing. Keep credentials and keystore outside source control.
AGM_ANDROID_RELEASE_KEYSTORE=
AGM_ANDROID_RELEASE_STORE_PASSWORD=
AGM_ANDROID_RELEASE_KEY_ALIAS=
AGM_ANDROID_RELEASE_KEY_PASSWORD=

# Translation provider
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
OPENAI_TRANSLATION_TIMEOUT_MS=20000
VITE_AGM_API_BASE_URL=http://127.0.0.1:3000/api/v1
AGM_TURN_ADMIN_PIN_HASH=replace-with-bcrypt-hash
