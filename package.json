{
  "name": "agm",
  "version": "1.3.0",
  "private": true,
  "description": "AGM AI-assisted vehicle transport management system",
  "scripts": {
    "build": "pnpm --filter @agm/api build",
    "dev": "pnpm --filter @agm/web dev",
    "api:dev": "pnpm --filter @agm/api start:dev",
    "web:dev": "pnpm --filter @agm/web dev",
    "web:build": "pnpm --filter @agm/web build",
    "web:pwa": "pnpm --filter @agm/web pwa:build",
    "android:add": "pnpm --filter @agm/web android:add",
    "android:sync": "pnpm --filter @agm/web android:sync",
    "android:open": "pnpm --filter @agm/web android:open",
    "android:apk": "pnpm --filter @agm/web android:apk",
    "start": "pnpm --filter @agm/api start",
    "lint": "pnpm --filter @agm/api lint",
    "test": "pnpm --filter @agm/api test",
    "db:up": "docker compose --env-file docker-compose.env up -d postgres",
    "db:down": "docker compose --env-file docker-compose.env down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed/seed.ts",
    "db:studio": "prisma studio",
    "audit:ui-live": "node scripts/ui-live-audit.mjs",
    "audit:wave1-browser": "node scripts/validate-wave1-browser.mjs",
    "audit:slice-a-desktop": "node scripts/validate-slice-a-desktop.mjs",
    "audit:slice-b-desktop": "node scripts/validate-slice-b-desktop.mjs",
    "audit:field-batch-01-desktop": "node scripts/validate-field-batch-01-desktop.mjs",
    "audit:field-batch-02-desktop": "node scripts/validate-field-batch-02-desktop.mjs",
    "audit:car-mover-p0-02-desktop": "node scripts/validate-car-mover-p0-02-desktop.mjs",
    "rescue:browser-preflight": "node scripts/rescue-browser-preflight.mjs",
    "audit:premium-copilot-c0": "node scripts/validate-premium-copilot-c0-desktop.mjs",
    "test:surface-sync": "node scripts/validate-product-surface.mjs",
    "test:browser-validation-flow": "tsx scripts/test-browser-validation-flow.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed/seed.ts"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "playwright": "^1.62.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.3"
}
