generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                         String                      @id @default(uuid()) @db.Uuid
  companyName                String
  countryCode                String                      @db.VarChar(2)
  defaultCurrencyCode        String                      @db.VarChar(3)
  timezone                   String                      @default("Europe/Berlin")
  isActive                   Boolean                     @default(true)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  users                      User[]
  roles                      Role[]
  lifecycleStates            LifecycleState[]
  transports                 TransportJob[]
  preDepartureSessions       PreDepartureSession[]
  operationalEventStreams    OperationalEventStream[]
  operationalEvents          OperationalEvent[]
  communicationConversations CommunicationConversation[]
  communicationMessages      CommunicationMessage[]
  carMoverVehicleSubjects    CarMoverVehicleSubject[]
  carMoverJobs               CarMoverJob[]
}

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  companyId            String                @db.Uuid
  company              Company               @relation(fields: [companyId], references: [id])
  displayName          String
  email                String
  passwordHash         String
  phoneNumber          String?
  status               String                @default("Active")
  personalDataStatus   String                @default("Active")
  anonymizedAt         DateTime?
  retentionUntil       DateTime?
  legalRetentionReason String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  lastLoginAt          DateTime?
  roles                UserRole[]
  authSessions         AuthSession[]
  preDepartureSessions PreDepartureSession[]

  @@unique([companyId, email])
}

model AuthSession {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @db.Uuid
  userId          String    @db.Uuid
  familyId        String    @db.Uuid
  generation      Int       @default(0)
  tokenHash       String    @unique @db.VarChar(64)
  expiresAt       DateTime
  revokedAt       DateTime?
  replacedAt      DateTime?
  reuseDetectedAt DateTime?
  lastUsedAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, expiresAt])
  @@index([familyId, generation])
}

model DataSubjectRequest {
  id                  String    @id @default(uuid()) @db.Uuid
  companyId           String    @db.Uuid
  requestedByUserId   String    @db.Uuid
  requestType         String    @db.VarChar(24)
  status              String    @default("RECEIVED") @db.VarChar(32)
  requestedAt         DateTime  @default(now())
  completedAt         DateTime?
  refusalReason       String?   @db.VarChar(240)
  exportSchemaVersion String?   @db.VarChar(40)
  exportSha256        String?   @db.VarChar(64)
  metadata            Json?

  @@index([companyId, requestedByUserId, requestedAt])
  @@index([status, requestedAt])
}

model DataRightsExternalRequest {
  id                    String    @id @default(uuid()) @db.Uuid
  companyId             String?   @db.Uuid
  subjectUserId         String?   @db.Uuid
  contactHash           String    @db.VarChar(64)
  requestType           String    @db.VarChar(24)
  status                String    @default("IDENTITY_PENDING") @db.VarChar(40)
  verificationTokenHash String?   @db.VarChar(64)
  verificationExpiresAt DateTime?
  verifiedAt            DateTime?
  notificationStatus    String    @default("PENDING") @db.VarChar(32)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  metadata              Json?

  @@index([contactHash, createdAt])
  @@index([status, verificationExpiresAt])
}

model SubjectDataIndex {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String?  @db.Uuid
  subjectId    String   @db.Uuid
  sourceTable  String   @db.VarChar(100)
  sourceColumn String   @db.VarChar(100)
  recordId     String   @db.VarChar(160)
  matchKind    String   @db.VarChar(32)
  discoveredAt DateTime @default(now())
  locator      Json?

  @@unique([subjectId, sourceTable, sourceColumn, recordId, matchKind])
  @@index([companyId, subjectId, sourceTable])
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  companyId   String     @db.Uuid
  company     Company    @relation(fields: [companyId], references: [id])
  code        String
  displayName String
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  users       UserRole[]

  @@unique([companyId, code])
}

model UserRole {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @db.Uuid
  userId           String   @db.Uuid
  roleId           String   @db.Uuid
  assignedByUserId String?  @db.Uuid
  assignedAt       DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id])
  role             Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model TurnAdminCredential {
  id             String    @id
  passwordHash   String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model LifecycleState {
  id            String                     @id @default(uuid()) @db.Uuid
  companyId     String?                    @db.Uuid
  company       Company?                   @relation(fields: [companyId], references: [id])
  countryCode   String?                    @db.VarChar(2)
  code          String
  displayName   String
  description   String?
  sortOrder     Int                        @default(0)
  isActive      Boolean                    @default(true)
  createdAt     DateTime                   @default(now())
  deprecatedAt  DateTime?
  transports    TransportJob[]
  fromHistories TransportJobStateHistory[] @relation("FromLifecycleState")
  toHistories   TransportJobStateHistory[] @relation("ToLifecycleState")

  @@unique([companyId, code])
  @@index([code])
}

model TransportJob {
  id                      String                     @id @default(uuid()) @db.Uuid
  companyId               String                     @db.Uuid
  company                 Company                    @relation(fields: [companyId], references: [id])
  transportNumber         String
  currentLifecycleStateId String                     @db.Uuid
  currentLifecycleState   LifecycleState             @relation(fields: [currentLifecycleStateId], references: [id])
  pickupAddressSnapshot   Json?
  deliveryAddressSnapshot Json?
  sourceConfidenceScore   Decimal?                   @db.Decimal(5, 2)
  plannedPickupFrom       DateTime?
  plannedPickupTo         DateTime?
  plannedDeliveryAt       DateTime?
  paymentAmount           Decimal?                   @db.Decimal(12, 2)
  currencyCode            String                     @default("EUR") @db.VarChar(3)
  isBlocked               Boolean                    @default(false)
  isArchived              Boolean                    @default(false)
  validationReportId      String?                    @db.Uuid
  auditEventId            String?                    @db.Uuid
  createdByUserId         String                     @db.Uuid
  updatedByUserId         String?                    @db.Uuid
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  stateHistory            TransportJobStateHistory[]
  validationReports       BusinessValidationReport[]
  auditEvents             AuditEvent[]
  financialLedger         FinancialLedger[]
  preDepartureSessions    PreDepartureSession[]

  @@unique([companyId, transportNumber])
  @@index([companyId, currentLifecycleStateId])
  @@index([createdAt])
}

model TransportJobStateHistory {
  id                        String          @id @default(uuid()) @db.Uuid
  companyId                 String          @db.Uuid
  transportJobId            String          @db.Uuid
  transportJob              TransportJob    @relation(fields: [transportJobId], references: [id])
  fromLifecycleStateId      String?         @db.Uuid
  fromLifecycleState        LifecycleState? @relation("FromLifecycleState", fields: [fromLifecycleStateId], references: [id])
  toLifecycleStateId        String          @db.Uuid
  toLifecycleState          LifecycleState  @relation("ToLifecycleState", fields: [toLifecycleStateId], references: [id])
  businessAction            String
  transitionReason          String?
  transitionedByUserId      String          @db.Uuid
  transitionedAt            DateTime        @default(now())
  approvedByUserId          String?         @db.Uuid
  validationReportId        String?         @db.Uuid
  relatedAIRecommendationId String?         @db.Uuid
  relatedAuditEventId       String          @db.Uuid
  metadata                  Json?

  @@index([transportJobId, transitionedAt])
  @@index([validationReportId])
}

model BusinessValidationReport {
  id                       String        @id @default(uuid()) @db.Uuid
  validationReportId       String        @unique @db.Uuid
  companyId                String        @db.Uuid
  validationType           String
  validationVersion        String
  parentValidationReportId String?       @db.Uuid
  correlationId            String        @db.Uuid
  requestId                String        @db.Uuid
  overallResult            String
  executedChecks           Json
  relatedBusinessAction    String
  relatedEntityType        String
  relatedEntityId          String        @db.Uuid
  transportJobId           String?       @db.Uuid
  transportJob             TransportJob? @relation(fields: [transportJobId], references: [id])
  auditEventId             String?       @db.Uuid
  stateHistoryId           String?       @db.Uuid
  executionDurationMs      Int
  createdAt                DateTime      @default(now())
  createdByUserId          String        @db.Uuid

  @@index([companyId, validationType])
  @@index([correlationId])
  @@index([transportJobId])
}

model AuditEvent {
  id                 String        @id @default(uuid()) @db.Uuid
  companyId          String        @db.Uuid
  actorUserId        String?       @db.Uuid
  actorType          String
  actionCode         String
  entityType         String
  entityId           String        @db.Uuid
  transportJobId     String?       @db.Uuid
  transportJob       TransportJob? @relation(fields: [transportJobId], references: [id])
  occurredAt         DateTime      @default(now())
  reason             String?
  beforeSnapshot     Json?
  afterSnapshot      Json?
  evidenceMetadataId String?       @db.Uuid
  aiRecommendationId String?       @db.Uuid
  humanDecisionId    String?       @db.Uuid
  validationReportId String?       @db.Uuid
  offlineSyncEventId String?       @db.Uuid
  ipAddress          String?
  deviceId           String?       @db.Uuid
  requestId          String        @db.Uuid
  correlationId      String        @db.Uuid
  metadata           Json?
  productId          String        @default("agm-cockpit") @db.VarChar(48)
  moduleId           String        @default("cockpit-core") @db.VarChar(80)
  subjectType        String        @default("TransportJob") @db.VarChar(64)
  subjectId          String?       @db.Uuid

  @@index([transportJobId, occurredAt])
  @@index([correlationId])
  @@index([validationReportId])
  @@index([companyId, productId, subjectType, subjectId, occurredAt])
}

model EvidenceMetadata {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @db.Uuid
  transportJobId   String?  @db.Uuid
  evidenceType     String
  storageProvider  String
  storageKey       String
  originalFileName String?
  mimeType         String?
  sizeBytes        Int?
  checksumSha256   String?
  description      String?
  uploadedByUserId String   @db.Uuid
  createdAt        DateTime @default(now())
  metadata         Json?

  @@unique([companyId, storageProvider, storageKey])
  @@index([companyId, transportJobId])
  @@index([companyId, evidenceType])
}

model IncidentReport {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @db.Uuid
  transportJobId   String    @db.Uuid
  incidentType     String
  severity         String
  status           String    @default("open")
  title            String
  description      String?
  reportedByUserId String    @db.Uuid
  resolvedByUserId String?   @db.Uuid
  resolvedAt       DateTime?
  resolutionNotes  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  metadata         Json?

  @@index([companyId, status])
  @@index([transportJobId, createdAt])
  @@index([companyId, severity])
}

model FinancialLedger {
  id                    String       @id @default(uuid()) @db.Uuid
  companyId             String       @db.Uuid
  transportJobId        String       @db.Uuid
  transportJob          TransportJob @relation(fields: [transportJobId], references: [id])
  ledgerNumber          String
  entryType             String
  amount                Decimal      @db.Decimal(12, 2)
  currencyCode          String       @db.VarChar(3)
  exchangeRateToBase    Decimal?     @db.Decimal(12, 6)
  occurredAt            DateTime
  recordedAt            DateTime     @default(now())
  recordedByUserId      String       @db.Uuid
  evidenceMetadataId    String?      @db.Uuid
  reversesLedgerEntryId String?      @db.Uuid
  description           String?
  metadata              Json?
  validationReportId    String?      @db.Uuid
  auditEventId          String       @db.Uuid

  @@index([transportJobId, occurredAt])
  @@index([companyId, ledgerNumber])
  @@index([validationReportId])
}

model PreDepartureSession {
  id               String               @id @default(uuid()) @db.Uuid
  companyId        String               @db.Uuid
  company          Company              @relation(fields: [companyId], references: [id])
  driverUserId     String               @db.Uuid
  driverUser       User                 @relation(fields: [driverUserId], references: [id])
  transportJobId   String?              @db.Uuid
  transportJob     TransportJob?        @relation(fields: [transportJobId], references: [id])
  clientSessionId  String               @db.Uuid
  idempotencyKey   String               @db.Uuid
  deviceId         String?              @db.Uuid
  vehicleReference String?              @db.VarChar(64)
  trailerReference String?              @db.VarChar(64)
  contractVersion  String               @db.VarChar(20)
  checklistVersion String               @db.VarChar(40)
  language         String               @db.VarChar(2)
  contexts         Json
  state            String               @db.VarChar(32)
  clientRevision   Int
  clientUpdatedAt  DateTime
  serverRevision   Int                  @default(0)
  startedAt        DateTime
  confirmedAt      DateTime?
  closedAt         DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  answers          PreDepartureAnswer[]

  @@unique([companyId, clientSessionId])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, state, updatedAt])
  @@index([transportJobId, updatedAt])
  @@index([driverUserId, updatedAt])
}

model PreDepartureAnswer {
  id                  String              @id @default(uuid()) @db.Uuid
  companyId           String              @db.Uuid
  sessionId           String              @db.Uuid
  session             PreDepartureSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  checkId             String              @db.VarChar(32)
  status              String              @db.VarChar(32)
  note                String?             @db.VarChar(500)
  notApplicableReason String?             @db.VarChar(240)
  answeredAt          DateTime
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([sessionId, checkId])
  @@index([companyId, status])
}

model OperationalEventStream {
  id             String             @id @default(uuid()) @db.Uuid
  companyId      String             @db.Uuid
  company        Company            @relation(fields: [companyId], references: [id])
  streamId       String             @db.Uuid
  aggregateType  String             @db.VarChar(64)
  currentVersion Int                @default(-1)
  projection     Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  events         OperationalEvent[]
  productId      String             @default("agm-cockpit") @db.VarChar(48)
  moduleId       String             @default("premium-operations") @db.VarChar(80)
  subjectType    String             @default("TripContext") @db.VarChar(64)
  subjectId      String?            @db.Uuid

  @@unique([companyId, streamId])
  @@index([companyId, updatedAt])
  @@index([companyId, productId, subjectType, subjectId])
}

model OperationalEvent {
  id               String                 @id @default(uuid()) @db.Uuid
  companyId        String                 @db.Uuid
  company          Company                @relation(fields: [companyId], references: [id])
  streamRecordId   String                 @db.Uuid
  stream           OperationalEventStream @relation(fields: [streamRecordId], references: [id], onDelete: Cascade)
  eventId          String                 @db.Uuid
  idempotencyKey   String                 @db.Uuid
  schemaVersion    String                 @db.VarChar(40)
  eventType        String                 @db.VarChar(120)
  eventVersion     Int
  aggregateVersion Int
  deviceId         String                 @db.Uuid
  deviceSequence   Int
  operationId      String                 @db.Uuid
  correlationId    String                 @db.Uuid
  occurredAt       DateTime
  recordedAt       DateTime
  payload          Json
  envelope         Json
  createdAt        DateTime               @default(now())
  productId        String                 @default("agm-cockpit") @db.VarChar(48)
  moduleId         String                 @default("premium-operations") @db.VarChar(80)
  subjectType      String                 @default("TripContext") @db.VarChar(64)
  subjectId        String?                @db.Uuid

  @@unique([companyId, eventId])
  @@unique([companyId, idempotencyKey])
  @@unique([streamRecordId, aggregateVersion])
  @@unique([streamRecordId, deviceId, deviceSequence])
  @@index([companyId, streamRecordId, aggregateVersion])
  @@index([companyId, occurredAt])
  @@index([companyId, productId, subjectType, subjectId, occurredAt])
}

model CarMoverVehicleSubject {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @db.Uuid
  company         Company       @relation(fields: [companyId], references: [id])
  productId       String        @default("agm-car-mover") @db.VarChar(48)
  vehicleClass    String        @db.VarChar(48)
  vehicleType     String        @db.VarChar(80)
  make            String?       @db.VarChar(120)
  model           String?       @db.VarChar(120)
  vin             String?       @db.VarChar(32)
  registration    String?       @db.VarChar(32)
  details         Json?
  createdByUserId String        @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  jobs            CarMoverJob[]

  @@index([companyId, productId, vehicleClass])
  @@index([companyId, productId, vin])
  @@index([companyId, productId, registration])
}

model CarMoverJob {
  id                   String                 @id @default(uuid()) @db.Uuid
  companyId            String                 @db.Uuid
  company              Company                @relation(fields: [companyId], references: [id])
  productId            String                 @default("agm-car-mover") @db.VarChar(48)
  moduleId             String                 @default("jobs") @db.VarChar(80)
  subjectType          String                 @default("CarMoverJob") @db.VarChar(64)
  vehicleSubjectId     String                 @db.Uuid
  vehicleSubject       CarMoverVehicleSubject @relation(fields: [vehicleSubjectId], references: [id])
  pickupSnapshot       Json
  destinationSnapshot  Json
  sourceType           String                 @default("manual") @db.VarChar(48)
  sourceReference      String?                @db.VarChar(160)
  currentState         String                 @default("DRAFT") @db.VarChar(32)
  lifecycleVersion     Int                    @default(0)
  createdByUserId      String                 @db.Uuid
  assignedDriverUserId String?                @db.Uuid
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([companyId, productId, sourceType, sourceReference])
  @@index([companyId, productId, currentState, updatedAt])
  @@index([companyId, productId, vehicleSubjectId])
}

model CommunicationConversation {
  id               String                 @id @default(uuid()) @db.Uuid
  companyId        String                 @db.Uuid
  company          Company                @relation(fields: [companyId], references: [id])
  channel          String                 @db.VarChar(16)
  provider         String                 @db.VarChar(32)
  externalThreadId String?                @db.VarChar(240)
  participantKey   String                 @db.VarChar(320)
  displayLabel     String?                @db.VarChar(160)
  tripId           String?                @db.Uuid
  status           String                 @default("open") @db.VarChar(24)
  lastMessageAt    DateTime
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  messages         CommunicationMessage[]

  @@unique([companyId, channel, provider, participantKey, externalThreadId])
  @@index([companyId, channel, lastMessageAt])
  @@index([companyId, tripId, lastMessageAt])
}

model CommunicationMessage {
  id                String                    @id @default(uuid()) @db.Uuid
  companyId         String                    @db.Uuid
  company           Company                   @relation(fields: [companyId], references: [id])
  conversationId    String                    @db.Uuid
  conversation      CommunicationConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channel           String                    @db.VarChar(16)
  provider          String                    @db.VarChar(32)
  direction         String                    @db.VarChar(12)
  clientMessageId   String?                   @db.Uuid
  providerMessageId String?                   @db.VarChar(240)
  providerEventId   String?                   @db.VarChar(240)
  fromAddress       String                    @db.VarChar(320)
  toAddress         String                    @db.VarChar(320)
  subject           String?                   @db.VarChar(500)
  bodyText          String
  status            String                    @db.VarChar(24)
  occurredAt        DateTime
  statusUpdatedAt   DateTime
  retryCount        Int                       @default(0)
  lastErrorCode     String?                   @db.VarChar(80)
  metadata          Json?
  createdByUserId   String?                   @db.Uuid
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([companyId, clientMessageId])
  @@unique([companyId, channel, provider, providerMessageId])
  @@unique([companyId, channel, provider, providerEventId])
  @@index([companyId, conversationId, occurredAt])
  @@index([companyId, status, statusUpdatedAt])
}
