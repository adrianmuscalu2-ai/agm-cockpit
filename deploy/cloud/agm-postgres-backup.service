[Unit]
Description=AGM PostgreSQL logical backup
Requires=docker.service
After=docker.service
ConditionPathIsDirectory=/opt/agm/backups

[Service]
Type=oneshot
User=root
Group=root
Environment=AGM_BACKUP_DIR=/opt/agm/backups/daily
Environment=AGM_POSTGRES_CONTAINER=app-postgres-1
Environment=AGM_BACKUP_RETENTION_COUNT=7
Environment=AGM_BACKUP_MINIMUM_FREE_KIB=1048576
ExecStart=/usr/local/sbin/agm-postgres-backup
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/agm/backups /run/lock
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
