# Copy to /opt/agm/production/secrets/agm-production.env with mode 0600.
# Replace every <REDACTED_REQUIRED> value through the approved secret channel.
# Never commit the resulting secret file.

POSTGRES_USER=agm_production
POSTGRES_PASSWORD=<REDACTED_REQUIRED>
POSTGRES_DB=agm_production

JWT_SECRET=<REDACTED_REQUIRED_MINIMUM_32_CHARACTERS>
JWT_EXPIRES_IN=1h
OPENAI_API_KEY=<REDACTED_REQUIRED>
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
OPENAI_TRANSLATION_TIMEOUT_MS=30000
TOMTOM_API_KEY=<REDACTED_REQUIRED>
GMAIL_FROM_ADDRESS=<REDACTED_REQUIRED>
GMAIL_OAUTH_CLIENT_ID=<REDACTED_REQUIRED>
GMAIL_OAUTH_CLIENT_SECRET=<REDACTED_REQUIRED>
GMAIL_OAUTH_REFRESH_TOKEN=<REDACTED_REQUIRED>
AGM_TURN_ADMIN_PIN_HASH=<REDACTED_REQUIRED>

TRUST_PROXY_HOPS=1
CORS_ALLOWED_ORIGINS=https://app.agmcockpit.com,https://agm-cockpit.pages.dev,https://localhost
AGM_API_HOST_PORT=3000

AGM_BACKUP_DIR=/opt/agm/backups/daily
AGM_BACKUP_RETENTION_COUNT=7

