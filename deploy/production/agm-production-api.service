[Unit]
Description=AGM Production API container lifecycle
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/agm/production/compose.production.yml
ConditionPathExists=/opt/agm/production/secrets/agm-production.env
ConditionPathExists=/opt/agm/production/release.env

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
WorkingDirectory=/opt/agm/production
EnvironmentFile=/opt/agm/production/release.env
ExecStartPre=/usr/bin/docker image inspect ${AGM_IMAGE}
ExecStartPre=/usr/bin/docker inspect agm-postgres
ExecStart=/usr/bin/docker compose --project-name agm-production --file /opt/agm/production/compose.production.yml up --detach --no-build --no-deps api
ExecStop=/usr/bin/docker compose --project-name agm-production --file /opt/agm/production/compose.production.yml stop --timeout 30 api
ExecReload=/usr/bin/docker restart --timeout 30 agm-production-api
TimeoutStartSec=180
TimeoutStopSec=60
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
