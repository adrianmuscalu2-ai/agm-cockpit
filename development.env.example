NODE_ENV=development
PORT=3100
API_HOST=127.0.0.1
TRUST_PROXY_HOPS=0
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5175,http://localhost:5175

AGM_DEV_WEB_PORT=5175
AGM_DEV_POSTGRES_PORT=55432
AGM_DEV_POSTGRES_USER=agm_development
AGM_DEV_POSTGRES_PASSWORD=replace-with-a-development-only-database-password
AGM_DEV_POSTGRES_DB=agm_development
DATABASE_URL=postgresql://agm_development:replace-with-a-development-only-database-password@127.0.0.1:55432/agm_development?schema=public
PRISMA_CONNECT_ON_BOOT=true

JWT_SECRET=replace-with-a-development-only-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h
MACHINE_JWT_SECRET=replace-with-a-separate-development-only-random-secret-at-least-32-characters
MACHINE_JWT_EXPIRES_IN=10m

DEFAULT_COMPANY_NAME=AGM Development
DEFAULT_COMPANY_COUNTRY=DE
DEFAULT_CURRENCY=EUR
SEED_OWNER_EMAIL=owner@agm-development.local
SEED_OWNER_PASSWORD=replace-with-a-development-only-owner-password
SEED_OWNER_NAME=AGM Development Owner

OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
OPENAI_TRANSLATION_TIMEOUT_MS=20000
VITE_AGM_API_BASE_URL=http://127.0.0.1:3100/api/v1
AGM_TURN_ADMIN_PIN_HASH=replace-with-a-development-only-bcrypt-hash

AGM_SOURCE_FRESHNESS_SCHEDULER_ENABLED=false
AGM_PRODUCT_OWNER_ALERT_EMAIL=
